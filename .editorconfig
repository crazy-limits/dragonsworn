root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

# Generated by tools/: never edited by hand, keep whatever the generator writes.
[{*.geo.json,*.animation.json,**/body/PoseData.java}]
indent_style = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
